# ==== Copiază în .env.test și completează valorile ====

# URL-ul aplicației pe care rulează testele (preview sau localhost)
E2E_BASE_URL=http://localhost:8080

# Cheile Supabase (le găsești în .env-ul proiectului)
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
# Necesar DOAR pentru scenariul "onboarding complet" (seed direct în DB)
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Cont Google DEDICAT pentru teste (nu contul tău personal!)
# Google blochează frecvent login-uri automatizate — vezi e2e/README.md
E2E_GOOGLE_EMAIL=
E2E_GOOGLE_PASSWORD=
