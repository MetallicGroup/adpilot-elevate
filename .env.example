# ============================================================================
# AdPilot — variabile de mediu (toate). Le pui în Vercel → Settings → Env Vars.
# SECRET = niciodată client-side. VITE_* ajung în bundle (publice, ok).
# ============================================================================

# --- Supabase (proiectul tău) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SECRET

# --- AI: Claude (text/agent/optimizare) + OpenAI (imagini/voce) ---
ANTHROPIC_API_KEY=                  # SECRET — console.anthropic.com (Sonnet 5 + Opus)
OPENAI_API_KEY=                     # SECRET — platform.openai.com (gpt-image-1 + Whisper)

# --- Email (Resend) ---
RESEND_API_KEY=                     # SECRET — resend.com (după verificarea domeniului)
EMAIL_FROM="AdPilot <noreply@adpilot.ro>"

# --- Stripe (direct, fără gateway Lovable) ---
STRIPE_LIVE_API_KEY=                # SECRET — sk_live_...
STRIPE_SANDBOX_API_KEY=             # SECRET — sk_test_...
PAYMENTS_LIVE_WEBHOOK_SECRET=       # SECRET — whsec_... (endpoint live)
PAYMENTS_SANDBOX_WEBHOOK_SECRET=    # SECRET — whsec_... (endpoint test)
VITE_PAYMENTS_CLIENT_TOKEN=         # public — pk_live_... / pk_test_...

# --- Meta Ads ---
META_APP_ID=
META_APP_SECRET=                    # SECRET
META_REDIRECT_URI=https://adpilot.ro/api/meta/auth/callback
META_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=          # SECRET — îl inventezi, identic în Meta

# --- WhatsApp (numărul central AdPilot) ---
ADPILOT_WA_TOKEN=                   # SECRET — WhatsApp Cloud API token
ADPILOT_WA_PHONE_ID=
ADPILOT_WA_DISPLAY_NUMBER=+40...
ADPILOT_WA_VERIFY_TOKEN=            # SECRET — îl inventezi, identic în Meta
ADPILOT_WA_APP_SECRET=             # SECRET — app secret al app-ului Meta care deține WABA
ADPILOT_ADMIN_WA_NUMBER=+40...     # numărul tău pentru alerte admin

# --- Securitate / cron / app ---
CRON_SECRET=                        # SECRET — îl inventezi (protejează /api/public/hooks/*)
ADPILOT_SIGNUP_HOOK_SECRET=         # SECRET — îl inventezi (și în webhook-ul DB Supabase)
APP_URL=https://adpilot.ro

# --- Opționale ---
TIKTOK_REDIRECT_URI=                # doar dacă activăm TikTok (acum draft-only)

# --- Legacy (vechiul stack WhatsApp) — se pot lăsa goale ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# TikTok Events API (marketing propriu AdPilot pe TikTok) — token din TikTok Events Manager
TIKTOK_EVENTS_ACCESS_TOKEN=
